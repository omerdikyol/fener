{
  "description": "Hyper+Space: fener launcher; Hyper+Shift+Space: fener menu",
  "manipulators": [
    {
      "type": "basic",
      "from": {
        "key_code": "spacebar",
        "modifiers": {
          "mandatory": [
            "left_control",
            "left_command",
            "left_option",
            "left_shift"
          ]
        }
      },
      "to": [
        {
          "shell_command": "$HOME/.local/bin/fener show menu"
        }
      ]
    },
    {
      "type": "basic",
      "from": {
        "key_code": "spacebar",
        "modifiers": {
          "mandatory": [
            "left_control",
            "left_command",
            "left_option"
          ]
        }
      },
      "to": [
        {
          "shell_command": "$HOME/.local/bin/fener toggle"
        }
      ]
    }
  ]
}
